# Sample environment file for memories-api.
# Copy this file to ".env" and adjust the values, then start with: docker compose up -d
#   cp .env.sample .env
# NOTE: keep comments on their own lines; text after "=" on a value line becomes part of the value.

# --- Server ---
# h2 (file database) or postgres
SPRING_PROFILES_ACTIVE=h2
SERVER_PORT=9090
H2_CONSOLE_ENABLED=false

# --- Database ---
# H2 (default): file inside the memories-db volume
DATASOURCE_URL=jdbc:h2:file:/data/memories-db/memories.db
DATASOURCE_USERNAME=sa
DATASOURCE_PASSWORD=change-me
# PostgreSQL example (with SPRING_PROFILES_ACTIVE=postgres):
# DATASOURCE_URL=jdbc:postgresql://postgres:5432/memories
# DATASOURCE_USERNAME=memories
# DATASOURCE_PASSWORD=Passw0rd

# --- Auth ---
# Generate your own, e.g.: openssl rand -base64 48
JWT_SECRET=szNjWVZXMoDDgH1Xl7N9dyWZYgMn3TXhbeDoCIwjFzY=
JWT_EXPIRATION=86400000

# --- Logging ---
# SQL statements (org.hibernate.SQL) and bound parameter values (Hibernate 6: org.hibernate.orm.jdbc.bind).
# Valid levels: OFF/FATAL/ERROR/WARN/INFO/DEBUG/TRACE. Keep parameter logging off in production (logs may contain data).
SQL_LOGGING_LEVEL=DEBUG
SQL_TYPE_DESCRIPTOR=TRACE
# Prints SQL to stdout regardless of log levels — keep false in production.
JPA_SHOW_SQL=false

# --- Media storage (inside the container volumes) ---
IMAGE_PATH=/data/memories-img
IMAGE_THUMBNAIL_PATH=/data/memories-img/th
IMAGE_ALLOWED_FORMATS=jpg|jpeg|png|gif|bmp|webp
IMAGE_RESIZE_IMAGES=true
IMAGE_MAX_SIZE=2048
IMAGE_THUMB_SIZE=320
VIDEO_PATH=/data/memories-vid
VIDEO_THUMBNAIL_PATH=/data/memories-vid/th
VIDEO_ALLOWED_FORMATS=mp4
# Max size of a single uploaded file / whole multipart request (raise for videos)
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=20MB

# --- App behavior ---
APP_BROADCAST_POSTS=true
APP_STORY_LIFETIME_HOURS=24
# End-to-end encrypted direct messages. When false, the server rejects key uploads
# and secured messages so clients automatically fall back to plaintext.
APP_E2E_ENABLED=true

# --- Native push notifications (APNs) ---
# The app also runs a background update check; enable native pushes to send real
# APNs pushes (alert with routing data + silent background pushes) on top of it.
APP_ENABLE_PUSH=false
# Apple developer key ID
APNS_KEY_ID=
# Apple team ID
APNS_TEAM_ID=
# app bundle identifier, used as the APNs topic
APNS_BUNDLE_ID=
# base64 of the .p8 signing key (single line, no headers)
APNS_PRIVATE_KEY_BASE64=
# true for the production APNs environment
APNS_PRODUCTION=false

# --- Mail (password reset etc.) ---
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=user
MAIL_PASSWORD=password
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL_ENABLE=true
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_CONNECTION_TIMEOUT=60000
MAIL_TIMEOUT=30000
MAIL_WRITE_TIMEOUT=60000
MAIL_FROM=no-reply@example.com
PASSWORD_RESET_BASE_URL=https://your-server-address/api/auth/reset-password
PASSWORD_RESET_CLEANUP_CRON=0 15 3 * * *
